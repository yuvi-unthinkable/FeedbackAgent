# Medical Voice Agent - Backend Environment Variables

PORT=4000

# Public URL (On Render: https://your-backend.onrender.com | Locally: your tunnel URL)
PUBLIC_URL=https://your-backend-app.onrender.com

# Google Gemini API Key (Gemini Live speech-to-speech)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Key (Post-Call Clinical Extraction & Medical Guardrails)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Twilio Credentials (Outbound Voice Calls & Media Streams)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Supabase PostgreSQL Database (Optional - in-memory fallback will be used if unset)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here